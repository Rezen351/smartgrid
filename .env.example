# ===========================================
# SmartGrid IoT Platform — Environment Config
# ===========================================

# --- Cloudflare Tunnel ---
# Create named tunnel at https://one.dash.cloudflare.com
# Then paste the token here.
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here
CLOUDFLARE_DOMAIN=your-domain.com

# --- Nginx ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --- Mosquitto MQTT Broker ---
# Internal MQTT (TCP, no TLS) — Docker network only
MOSQUITTO_MQTT_PORT=1883
# Secure MQTT (TCP/TLS) — exposed for field devices
MOSQUITTO_MQTTS_PORT=8883
# WebSocket (via Nginx reverse proxy)
MOSQUITTO_WS_PORT=9001

# --- InfluxDB (Time-Series Database) ---
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=admin
INFLUXDB_ORG=smartgrid
INFLUXDB_BUCKET=smartgrid_data
INFLUXDB_RETENTION=30d
INFLUXDB_PORT=8086

# --- PostgreSQL (Metadata / Auth) ---
POSTGRES_USER=smartgrid
POSTGRES_PASSWORD=changeme-postgres
POSTGRES_DB=smartgrid
POSTGRES_PORT=5432

# --- Auth Service ---
JWT_SECRET=change-me-jwt-secret-please
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_EMAIL=admin@smartgrid.local
AUTH_ADMIN_PASSWORD=admin1234

AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_pass
AUTH_DB_NAME=auth_db

# --- Grafana (Visualization) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_PORT=3000

# --- Module Service ---
MODULE_DB_USER=module_user
MODULE_DB_PASSWORD=module_pass
MODULE_DB_NAME=module_db
MODULE_DB_ROOT_PASSWORD=rootpass

TIMESCALE_DB_USER=module_user
TIMESCALE_DB_PASSWORD=module_pass
TIMESCALE_DB_NAME=module_ts

REDIS_PASSWORD=
REDIS_DB=0

NATS_URL=nats://nats:4222

MQTT_URL=tcp://mosquitto:1883
MQTT_USER=
MQTT_PASS=
MQTT_CLIENT_ID=module
MQTT_TOPIC_PREFIX=smartfarm
