# ===========================================
# SmartGrid IoT Platform — Environment Config
# ===========================================

# --- Cloudflare Tunnel ---
# Create named tunnel at https://one.dash.cloudflare.com
# Then paste the token here.
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here
CLOUDFLARE_DOMAIN=your-domain.com

# --- Mosquitto MQTT Broker ---
# Internal MQTT (TCP, no TLS) — Docker network only
MOSQUITTO_MQTT_PORT=1883
# Secure MQTT (TCP/TLS) — exposed for field devices
MOSQUITTO_MQTTS_PORT=8883
# WebSocket (via Nginx reverse proxy)
MOSQUITTO_WS_PORT=9001

# --- PostgreSQL (Metadata / Auth) ---
POSTGRES_USER=smartgrid
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=smartgrid
POSTGRES_DSN=postgresql://smartgrid:CHANGE_ME_postgres_password@postgres-dashboard:5432/smartgrid?sslmode=disable

# --- Auth Service ---
JWT_SECRET=CHANGE_ME_jwt_secret
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_EMAIL=admin@smartgrid.local
AUTH_ADMIN_PASSWORD=CHANGE_ME_admin_password

AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=CHANGE_ME_auth_db_password
AUTH_DB_NAME=auth_db
AUTH_POSTGRES_DSN=postgresql://auth_user:CHANGE_ME_auth_db_password@postgres-auth:5432/auth_db?sslmode=disable

# --- Grafana (Visualization) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password

# --- Module Service ---
MODULE_DB_USER=module_user
MODULE_DB_PASSWORD=CHANGE_ME_module_db_password
MODULE_DB_NAME=module_db
MODULE_DB_ROOT_PASSWORD=CHANGE_ME_module_root_password
MODULE_DB_DSN=module_user:CHANGE_ME_module_db_password@tcp(mariadb-module:3306)/module_db?parseTime=true&charset=utf8mb4

TIMESCALE_DB_USER=module_user
TIMESCALE_DB_PASSWORD=CHANGE_ME_timescale_password
TIMESCALE_DB_NAME=module_ts
TIMESCALE_DSN=postgres://module_user:CHANGE_ME_timescale_password@timescaledb-module:5432/module_ts?sslmode=disable

REDIS_PASSWORD=
REDIS_DB=0

NATS_URL=nats://nats:4222

MQTT_URL=tcp://mosquitto:1883
MQTT_USER=
MQTT_PASS=
MQTT_CLIENT_ID=module
MQTT_TOPIC_PREFIX=smartfarm
